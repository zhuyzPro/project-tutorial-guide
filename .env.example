# Required in production
NODE_ENV=production
HOST=127.0.0.1
PORT=4899
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true

# Public URL served by your reverse proxy, for example https://guide.example.com
ADMIN_ORIGIN=https://guide.example.com

# When the application is exposed beneath proxy prefixes, scope the login
# cookie to its API prefix. The project-tutorial-guide production deployment
# uses /project-tutorial-guide-api/.
COOKIE_PATH=/api/

# Add your GitHub Pages origin only when the static front end is hosted there.
# PUBLIC_ORIGINS=https://your-account.github.io,https://your-custom-domain.example

# Optional persistent path for the SQLite file.
# DB_PATH=/var/lib/guide-admin/guide.sqlite
